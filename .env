APP_NAME="Commune de Makary"
APP_ENV=local
APP_KEY=base64:awuE8U1wN4zX56NmbC7ljU8ygaPeQiQHXfzbPkdIfDc=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_TIMEZONE=Africa/Douala
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de développement : PostgreSQL 18 (PGlite) lancé par « node outils-dev/lancer.mjs ».
# En production : un vrai PostgreSQL, avec DB_EMULATE_PREPARES=false.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=makary
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Double authentification (TOTP 2FA) : désactivée définitivement (en ligne et en local)
MAKARY_MFA_ACTIVE=false
MAKARY_MFA_DISPENSEE_EN_LOCAL=false

# Antivirus : false en environnement de développement ou hébergement mutualisé
MAKARY_ANTIVIRUS_REQUIS=false

# Désactiver les mentions et bandeaux de données fictives
MAKARY_DONNEES_FICTIVES=false


