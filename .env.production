# ==============================================================================
# Configuration pour Hébergement Mutualisé (cPanel, OVH, Plesk, Hostinger, etc.)
# Sans accès SSH ni FTP : modifiez ce fichier directement via le Gestionnaire de Fichiers cPanel
# ==============================================================================

APP_NAME="Commune de Makary"
APP_ENV=production
APP_KEY=base64:t2qCbGRPLK0Nq/qfSshpM2syYQAkjkun4l9/AjhO4I0=
APP_DEBUG=false
APP_URL=https://votre-domaine.cm

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Douala

# Journalisation
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base de données mutualisée (MySQL 8.0+ ou MariaDB 10.4+)
# Renseignez ici les accès créés dans votre panneau cPanel > Bases de données MySQL :
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nomcpanel_makary
DB_USERNAME=nomcpanel_utilisateur
DB_PASSWORD="votre_mot_de_passe_securise"

# Sessions sécurisées (stockées en base de données, HTTPS obligatoire)
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Cache et files d'attente (en base de données)
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Messagerie transactionnelle (SMTP de votre hébergeur ou boîte mail cPanel)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.votre-domaine.cm
MAIL_PORT=465
MAIL_USERNAME=contact@votre-domaine.cm
MAIL_PASSWORD="mot_de_passe_boite_mail"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@votre-domaine.cm"
MAIL_FROM_NAME="${APP_NAME}"

# Paramètres municipaux
MAKARY_DONNEES_FICTIVES=false
# Double authentification (TOTP 2FA) : désactivée définitivement (en ligne et en local)
MAKARY_MFA_ACTIVE=false
MAKARY_MFA_DISPENSEE_EN_LOCAL=false

# Antivirus sur hébergement mutualisé :
# Comme ClamAV n'est généralement pas installé sur les serveurs mutualisés,
# MAKARY_ANTIVIRUS_REQUIS=false permet d'accepter les téléversements.
# Les images restent assainies par la recompression GD (EXIF et scripts supprimés).
MAKARY_ANTIVIRUS=
MAKARY_ANTIVIRUS_REQUIS=false
MAKARY_ANTIVIRUS_OPTIONS=--no-summary

# Durées de conservation (jours)
MAKARY_CONSERVATION_JOURNAL_JOURS=365
MAKARY_CONSERVATION_DEMANDE_JOURS=730
