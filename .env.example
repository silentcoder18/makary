APP_NAME="Commune de Makary"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_TIMEZONE=Africa/Douala
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données : MySQL 8.0.16+ ou MariaDB 10.4+ (D13). En production : MariaDB 10.11/11.4 LTS ou MySQL 8.4 LTS,
# avec un compte dédié (jamais root). Bases de test et de recette : « php artisan makary:creer-base ».
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=makary
DB_USERNAME=makary
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Double authentification (TOTP 2FA) : désactivée définitivement (en ligne et en local).
MAKARY_MFA_ACTIVE=false
MAKARY_MFA_DISPENSEE_EN_LOCAL=false

# Antivirus des fichiers téléversés (MKY-P3-08) : exécutable ClamAV (clamdscan ou clamscan) et ses options.
# Sur un serveur avec ClamAV disponible : renseigner le chemin d'accès (ex. /usr/bin/clamdscan).
# Sur hébergement mutualisé sans ClamAV : définir MAKARY_ANTIVIRUS_REQUIS=false pour accepter les médias.
# Les images restent assainies par la recompression GD (EXIF et scripts supprimés).
MAKARY_ANTIVIRUS=
MAKARY_ANTIVIRUS_REQUIS=true
MAKARY_ANTIVIRUS_OPTIONS=--no-summary

# Mention de données fictives (bandeaux et pied de page) : false pour masquer
MAKARY_DONNEES_FICTIVES=false


